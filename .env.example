# Copie para .env (NUNCA committar .env — ver .gitignore).
# Hoje o site é 100% estático e não precisa de nenhuma variável para rodar.
# As chaves abaixo são só o contrato para quando o backlog avançar.

# Site (usado no build para URLs absolutas / sitemap / OG)
PUBLIC_SITE_URL=https://dermelab.art

# --- Backlog: gateway de pagamento (definir com o Erico antes de codar checkout) ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=

# --- Backlog: CMS headless do catálogo (ex.: Sanity) ---
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_TOKEN=

# --- Backlog: formulário de lead B2B (endpoint de envio) ---
# CONTACT_FORM_ENDPOINT=
