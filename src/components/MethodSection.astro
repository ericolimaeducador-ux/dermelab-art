---
const steps = [
  {
    num: '01',
    label: 'Compreensão Celular',
    text: 'Como a pele se comporta durante e após a perfuração mecânica — integridade das camadas, resposta inflamatória e a janela crítica de cicatrização dérmica.',
  },
  {
    num: '02',
    label: 'Formulação Ativa',
    text: 'Ativos biocompatíveis selecionados para reforçar a barreira cutânea e evitar a dispersão do pigmento, sem obstrução dos poros.',
  },
  {
    num: '03',
    label: 'Aplicação & Protocolo',
    text: 'Método simplificado desenhado para a rotina prática do tatuador em estúdio e o cuidado diário do cliente até a alta.',
  },
];
---

<section id="metodo" class="bg-graphite-950 text-lab-50 px-6 sm:px-12 py-24 border-t border-white/10">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16">
      <div>
        <p class="font-mono text-xs text-glass-sage uppercase tracking-widest mb-3">Método Científico</p>
        <h2 class="font-display text-3xl sm:text-5xl max-w-2xl leading-[1.1]">
          Antes de virar produto, vira estudo clínico.
        </h2>
      </div>
      <p class="font-mono text-xs text-white/50 max-w-xs text-left md:text-right">
        AUTORIDADE · ASSEPSIA · MÉTODO
      </p>
    </div>

    <ol class="grid gap-8 md:grid-cols-3 border-t border-white/10 pt-10">
      {steps.map((step) => (
        <li class="space-y-4">
          <p class="font-mono text-sm text-glass-sage">{step.num}</p>
          <h3 class="font-display text-2xl text-lab-50">{step.label}</h3>
          <p class="font-body text-sm text-white/70 leading-relaxed">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
