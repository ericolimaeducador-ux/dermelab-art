---
interface Props {
  slug: string;
  name: string;
  price: number;
  currency?: string;
  image: string;
  portrait?: boolean;
}

const { slug, name, price, currency = 'BRL', image, portrait = false } = Astro.props;

const formattedPrice = new Intl.NumberFormat('pt-BR', {
  style: 'currency',
  currency,
}).format(price);
---

<a
  href={`/produto/${slug}`}
  class:list={[
    'group relative block overflow-hidden bg-graphite-900 border border-white/5',
    portrait ? 'aspect-[3/4]' : 'aspect-[4/3]',
  ]}
>
  <img
    src={image}
    alt={name}
    loading="lazy"
    class="h-full w-full object-cover transition-all duration-700 group-hover:scale-105 group-hover:opacity-85"
  />
  
  <div class="absolute inset-0 bg-gradient-to-t from-graphite-950/95 via-graphite-950/20 to-transparent p-5 flex flex-col justify-end opacity-90 group-hover:opacity-100 transition-opacity">
    <div class="flex items-end justify-between gap-4">
      <div>
        <span class="font-mono text-[10px] text-glass-sage uppercase tracking-wider block mb-1">PRODUTO CLÍNICO</span>
        <h3 class="font-display text-lg sm:text-xl text-lab-50 leading-tight group-hover:text-glass-sage transition-colors">{name}</h3>
      </div>
      <span class="price font-mono text-xs whitespace-nowrap font-medium px-2 py-1 bg-graphite-950/80 border border-white/10">
        {price > 0 ? formattedPrice : 'SOB CONSULTA'}
      </span>
    </div>
  </div>
</a>
