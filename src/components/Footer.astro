---
import site from '../data/site.json';
import Wordmark from './Wordmark.astro';
const year = new Date().getFullYear();
---

<footer class="bg-graphite-950 text-lab-50 px-6 py-12">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-8">
    <div>
      <Wordmark size="lg" />
      <p class="font-display text-lg mt-3 max-w-xs">{site.tagline}</p>
    </div>
    <ul class="font-body text-sm space-y-1 text-glassline">
      <li><a href={`mailto:${site.email}`} class="hover:text-lab-50">{site.email}</a></li>
      <li><a href={site.instagram} class="hover:text-lab-50" target="_blank" rel="noreferrer">Instagram</a></li>
      <li><a href={site.whatsapp} class="hover:text-lab-50" target="_blank" rel="noreferrer">WhatsApp — atacado</a></li>
    </ul>
  </div>
  <p class="font-mono text-xs text-graphite-700 mt-10">© {year} {site.fullName}</p>
</footer>
