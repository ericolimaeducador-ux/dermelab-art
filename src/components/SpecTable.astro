---
interface Spec {
  label: string;
  value: string;
}

interface Props {
  specs: Spec[];
}

const { specs } = Astro.props;
---

<table class="w-full font-mono text-xs sm:text-sm">
  <tbody>
    {specs.map((spec) => (
      <tr class="border-t border-white/10">
        <th class="py-3 pr-4 text-left font-normal text-white/50 w-1/3">{spec.label}</th>
        <td class="py-3 text-lab-50">{spec.value}</td>
      </tr>
    ))}
  </tbody>
</table>
