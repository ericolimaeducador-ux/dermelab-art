---
interface Spec {
  label: string;
  value: string;
}

interface Props {
  specs: Spec[];
}

const { specs } = Astro.props;
---

<table class="w-full font-mono text-sm">
  <tbody>
    {specs.map((spec) => (
      <tr class="border-t border-glassline">
        <th class="py-2 pr-4 text-left font-normal text-graphite-700/70 w-1/3">{spec.label}</th>
        <td class="py-2 text-graphite-950">{spec.value}</td>
      </tr>
    ))}
  </tbody>
</table>
