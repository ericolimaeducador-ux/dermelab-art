---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página Não Encontrada">
  <div class="bg-graphite-950 min-h-screen text-lab-50 flex items-center justify-center px-6 py-32">
    <div class="text-center max-w-lg space-y-6">
      <p class="font-mono text-sm text-glass-sage">404 — ESTUDO NÃO LOCALIZADO</p>
      <h1 class="font-display text-4xl sm:text-6xl">Página Inexistente</h1>
      <p class="font-body text-sm text-white/60">
        A página solicitada não foi encontrada ou foi movida no catálogo.
      </p>
      <div class="pt-4 flex justify-center gap-4 font-mono text-xs">
        <a href="/" class="px-5 py-2.5 bg-white text-graphite-950 font-medium hover:bg-glass-sage hover:text-white transition-colors">
          Início
        </a>
        <a href="/loja" class="px-5 py-2.5 border border-white/20 hover:border-white transition-colors">
          Catálogo
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
