---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada">
  <section class="min-h-[60vh] pt-28 px-6 max-w-prose mx-auto flex flex-col justify-center">
    <p class="font-mono text-sm text-glass-sage mb-3">404</p>
    <h1 class="font-display text-4xl mb-4">Essa página saiu de circulação.</h1>
    <p class="font-body text-base text-graphite-700 mb-8">
      O endereço pode ter mudado ou o conteúdo ainda não existe.
    </p>
    <nav class="font-body text-base flex flex-wrap gap-4">
      <a href="/" class="underline hover:text-glass-sage">Início</a>
      <a href="/loja" class="underline hover:text-glass-sage">Catálogo</a>
      <a href="/contato" class="underline hover:text-glass-sage">Contato</a>
    </nav>
  </section>
</BaseLayout>
