---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---

<BaseLayout title="Contato">
  <section class="pt-24 px-6 max-w-prose mx-auto">
    <h1 class="font-display text-4xl mb-6">Contato & atacado</h1>
    <p class="font-body text-base leading-relaxed mb-8">
      Estúdios e lojistas: fale com o time comercial para tabela de atacado e amostras.
    </p>
    <ul class="font-body text-base space-y-2">
      <li>E-mail: <a href={`mailto:${site.email}`} class="underline">{site.email}</a></li>
      <li>WhatsApp: <a href={site.whatsapp} class="underline">{site.whatsapp}</a></li>
    </ul>
    <!-- TODO(feature): formulário de lead B2B com validação (Zod) — mesmo padrão usado
         no ContactForm do projeto SWB do Erico. -->
  </section>
</BaseLayout>
