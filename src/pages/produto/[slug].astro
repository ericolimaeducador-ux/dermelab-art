---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecTable from '../../components/SpecTable.astro';
import productsData from '../../data/products.sample.json';

export function getStaticPaths() {
  return productsData.items.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;

const formattedPrice = new Intl.NumberFormat('pt-BR', {
  style: 'currency',
  currency: product.currency,
}).format(product.price);
---

<BaseLayout title={product.name} description={product.shortDescription}>
  <div class="bg-graphite-950 min-h-screen text-lab-50 pt-28 pb-20 px-6 sm:px-12">
    <div class="max-w-7xl mx-auto">
      <nav class="mb-8 font-mono text-xs text-glass-sage">
        <a href="/loja" class="hover:text-white transition-colors">← Voltar para a Loja</a>
      </nav>

      <section class="grid gap-12 lg:grid-cols-12 lg:gap-16 items-start">
        <!-- Coluna de imagem — sticky no desktop (scroll-telling) -->
        <div class="lg:col-span-7 lg:sticky lg:top-28">
          <div class="relative aspect-[4/3] w-full bg-graphite-900 border border-white/10 overflow-hidden">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Coluna de informações e specs -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <span class="font-mono text-xs text-glass-sage uppercase tracking-widest block mb-2">
              DERMELAB · ART
            </span>
            <h1 class="font-display text-4xl sm:text-5xl leading-tight">{product.name}</h1>
            <p class="price font-mono text-xl sm:text-2xl mt-4 font-medium">
              {product.price > 0 ? formattedPrice : 'Sob consulta — atacado & estúdios'}
            </p>
          </div>

          <p class="font-body text-sm sm:text-base text-white/70 leading-relaxed max-w-prose">
            {product.shortDescription}
          </p>

          <div>
            <a
              href="/contato"
              class="inline-block w-full text-center font-body text-sm font-medium bg-pigment-red text-white px-6 py-4 hover:opacity-90 transition-opacity"
            >
              Consultar Disponibilidade & Preços
            </a>
          </div>

          <div class="pt-8 border-t border-white/10">
            <h2 class="font-display text-2xl mb-4">Especificações Técnicas</h2>
            <SpecTable specs={product.specs} />

            {product.regulatory === null && (
              <p class="font-mono text-xs text-white/40 mt-6">
                [PENDENTE — registro sanitário/procedência a confirmar antes da publicação]
              </p>
            )}
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
