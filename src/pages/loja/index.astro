---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import categoriesData from '../../data/categories.json';
import productsData from '../../data/products.sample.json';

const categories = categoriesData.items;
const products = productsData.items;
---

<BaseLayout title="Loja & Catálogo">
  <div class="bg-graphite-950 min-h-screen text-lab-50 pt-28 pb-20 px-6 sm:px-12">
    <div class="max-w-7xl mx-auto">
      <!-- Header da Loja -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/10">
        <div>
          <p class="font-mono text-xs text-glass-sage uppercase tracking-widest mb-2">Linha de Cuidado & Cicatrização</p>
          <h1 class="font-display text-4xl sm:text-6xl">Catálogo Oficial</h1>
        </div>
        <p class="font-mono text-xs text-white/50">
          {products.length} PRODUTOS SELECIONADOS
        </p>
      </div>

      <!-- Filtros por Categoria -->
      <nav class="flex flex-wrap items-center gap-2 sm:gap-3 my-8 font-mono text-xs">
        <a
          href="/loja"
          class="px-4 py-2 bg-white text-graphite-950 font-medium"
        >
          Todos
        </a>
        {categories.map((cat) => (
          <a
            href={`/loja/${cat.slug}`}
            class="px-4 py-2 border border-white/20 text-white/80 hover:border-white hover:text-white transition-colors"
          >
            {cat.name}
          </a>
        ))}
      </nav>

      <!-- Grade Editorial de Produtos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-10">
        {products.map((p, idx) => (
          <ProductCard
            slug={p.slug}
            name={p.name}
            price={p.price}
            currency={p.currency}
            image={p.image}
            portrait={idx % 2 === 1}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
