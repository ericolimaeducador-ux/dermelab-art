---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import categoriesData from '../../data/categories.json';
import productsData from '../../data/products.sample.json';

const categories = categoriesData.items;
const products = productsData.items;
---

<BaseLayout title="Loja">
  <section class="pt-24 px-6">
    <h1 class="font-display text-4xl">Catálogo</h1>

    <!-- TODO(feature): filtro client-side por categoria — ver CLAUDE.md backlog item 3 -->
    <nav class="flex flex-wrap gap-3 mt-6 mb-10 font-body text-sm">
      {categories.map((cat) => (
        <a
          href={`/loja/${cat.slug}`}
          class="border border-graphite-700/30 px-3 py-1 hover:border-glass-sage hover:text-glass-sage transition-colors"
        >
          {cat.name}
        </a>
      ))}
    </nav>
  </section>

  <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-1 bg-graphite-950">
    {products.map((p) => (
      <ProductCard
        slug={p.slug}
        name={p.name}
        price={p.price}
        currency={p.currency}
        image={p.image}
      />
    ))}
  </section>
</BaseLayout>
