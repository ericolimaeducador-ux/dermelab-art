---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import categoriesData from '../../data/categories.json';
import productsData from '../../data/products.sample.json';

// Catálogo filtrado por categoria (CLAUDE.md backlog item 5). Rota estática:
// uma página por categoria de categories.json. Filtro client-side em /loja
// continua no backlog — aqui é navegação direta por URL.
export function getStaticPaths() {
  return categoriesData.items.map((cat) => ({
    params: { categoria: cat.slug },
    props: {
      category: cat,
      products: productsData.items.filter((p) => p.category === cat.slug),
    },
  }));
}

const { category, products } = Astro.props;
const categories = categoriesData.items;
---

<BaseLayout title={category.name} description={`Catálogo — ${category.name}`}>
  <section class="pt-24 px-6">
    <p class="font-mono text-sm text-glass-sage mb-2">Categoria</p>
    <h1 class="font-display text-4xl">{category.name}</h1>

    <nav class="flex flex-wrap gap-3 mt-6 mb-10 font-body text-sm">
      <a
        href="/loja"
        class="border border-graphite-700/30 px-3 py-1 hover:border-glass-sage hover:text-glass-sage transition-colors"
      >
        Todos
      </a>
      {categories.map((cat) => (
        <a
          href={`/loja/${cat.slug}`}
          class:list={[
            'border px-3 py-1 transition-colors',
            cat.slug === category.slug
              ? 'border-glass-sage text-glass-sage'
              : 'border-graphite-700/30 hover:border-glass-sage hover:text-glass-sage',
          ]}
        >
          {cat.name}
        </a>
      ))}
    </nav>
  </section>

  {products.length > 0 ? (
    <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-1 bg-graphite-950">
      {products.map((p) => (
        <ProductCard
          slug={p.slug}
          name={p.name}
          price={p.price}
          currency={p.currency}
          image={p.image}
        />
      ))}
    </section>
  ) : (
    <section class="px-6 pb-24">
      <p class="font-mono text-sm text-graphite-700/70">
        Nenhum produto nesta categoria ainda — em breve.
      </p>
    </section>
  )}
</BaseLayout>
