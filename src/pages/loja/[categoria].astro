---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import categoriesData from '../../data/categories.json';
import productsData from '../../data/products.sample.json';

export function getStaticPaths() {
  return categoriesData.items.map((cat) => ({
    params: { categoria: cat.slug },
    props: {
      category: cat,
      products: productsData.items.filter((p) => p.category === cat.slug),
    },
  }));
}

const { category, products } = Astro.props;
const categories = categoriesData.items;
---

<BaseLayout title={`Catálogo — ${category.name}`} description={`Linha de produtos — ${category.name}`}>
  <div class="bg-graphite-950 min-h-screen text-lab-50 pt-28 pb-20 px-6 sm:px-12">
    <div class="max-w-7xl mx-auto">
      <!-- Header da Categoria -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/10">
        <div>
          <p class="font-mono text-xs text-glass-sage uppercase tracking-widest mb-2">Categoria</p>
          <h1 class="font-display text-4xl sm:text-6xl">{category.name}</h1>
        </div>
        <a href="/loja" class="font-mono text-xs text-glass-sage hover:text-white transition-colors">
          ← Voltar para todos os produtos
        </a>
      </div>

      <!-- Filtros por Categoria -->
      <nav class="flex flex-wrap items-center gap-2 sm:gap-3 my-8 font-mono text-xs">
        <a
          href="/loja"
          class="px-4 py-2 border border-white/20 text-white/80 hover:border-white hover:text-white transition-colors"
        >
          Todos
        </a>
        {categories.map((cat) => (
          <a
            href={`/loja/${cat.slug}`}
            class:list={[
              'px-4 py-2 transition-colors',
              cat.slug === category.slug
                ? 'bg-white text-graphite-950 font-medium'
                : 'border border-white/20 text-white/80 hover:border-white hover:text-white',
            ]}
          >
            {cat.name}
          </a>
        ))}
      </nav>

      <!-- Lista de Produtos -->
      {products.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-10">
          {products.map((p, idx) => (
            <ProductCard
              slug={p.slug}
              name={p.name}
              price={p.price}
              currency={p.currency}
              image={p.image}
              portrait={idx % 2 === 1}
            />
          ))}
        </div>
      ) : (
        <div class="py-24 text-center border border-white/10 mt-10">
          <p class="font-mono text-sm text-white/60">
            Nenhum produto cadastrado nesta categoria no momento — em breve.
          </p>
          <a href="/loja" class="mt-4 inline-block font-body text-xs text-glass-sage hover:underline">
            Explorar catálogo completo →
          </a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
